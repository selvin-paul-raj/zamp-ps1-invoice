# Backend
DATABASE_URL=sqlite:///./zamp_ps1.db          # or set PGHOST/PGUSER/PGPASSWORD/PGDATABASE for Postgres
PIPELINE_STEP_DELAY_MS=350                    # slows steps so the live view is watchable; 0 for batch
APPROVE_CONFIDENCE_THRESHOLD=0.85
WORKER_MAX_ATTEMPTS=3
CORS_ORIGINS=*
DECISION_LLM_PROVIDER=                        # empty = no LLM; deterministic template explanations
BUYER_GSTIN=33AABCZ4321P1Z4                   # our company's GSTIN (decides CGST+SGST vs IGST)
APPROVAL_LIMIT_INR=500000                     # above this, a Finance Controller signs off
EXTRACTION_LLM_URL=                           # optional OpenAI-compatible endpoint for unknown PDF layouts
EXTRACTION_LLM_KEY=                           # (never commit a real key)
EXTRACTION_LLM_MODEL=gpt-4o-mini
# Frontend (only for `npm run dev` against a separate API; the bundled build uses /api)
NEXT_PUBLIC_API_URL=http://localhost:8000
