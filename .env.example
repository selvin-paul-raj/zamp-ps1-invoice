# ---------------------------------------------------------------- core
DATABASE_URL=sqlite:///./zamp_ps1.db          # or postgresql+psycopg://user:pass@host/db (or PGHOST/PGUSER/PGPASSWORD/PGDATABASE)
PIPELINE_STEP_DELAY_MS=350                    # slows steps so the live view is watchable; 0 for batch
APPROVE_CONFIDENCE_THRESHOLD=0.85
WORKER_MAX_ATTEMPTS=3                         # then the job goes to the dead-letter queue and the invoice is held (fail closed)
CORS_ORIGINS=*
BUYER_GSTIN=33AABCZ4321P1Z4                   # our company's GSTIN (decides CGST+SGST vs IGST)
APPROVAL_LIMIT_INR=500000                     # above this, a Finance Controller signs off
BANK_CHANGE_COOLDOWN_DAYS=30                  # vendor-master bank change younger than this + not call-back verified -> hold

# ---------------------------------------------------------------- Jev (TypeSafe), advisory only. Never approves.
JEV_MODE=replay                               # off | replay (recorded real answers, no network, default) | live
# JEV_ENABLED=1                               # shorthand for live (falls back to replay if no key); JEV_ENABLED=0 = off
# TYPESAFE_API_KEY=                           # or JEV_API_KEY. Set it in the host's secret store; never commit it.
JEV_MODEL=jev-latest                          # pin e.g. jev-1.13.0 once thresholds are tuned on that version
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_S=10
JEV_DUP_HOLD_P=0.70                           # duplicate judgement: p >= this adds a HOLD for a person
JEV_PO_MIN_P=0.80                             # PO choice: below this (or inconsistent) a person picks the PO
JEV_FIELD_MIN_P=0.80                          # field check: below this the field is flagged for a person
JEV_RECORD=0                                  # 1 = save live answers to seed/jev_replay.json (evals)

# ---------------------------------------------------------------- production switches (defaults = simple demo mode)
AUTH_MODE=off                                 # off | apikey
# API_KEYS=key1:viewer,key2:operator,key3:reviewer:rita,key4:approver:arun,key5:admin
RATE_LIMIT_PER_MIN=0                          # 0 = off
WORKER_MODE=inline                            # inline (in the API process) | external (run `python -m app.worker`)
JOB_LEASE_SECONDS=120
DB_MIGRATE=create_all                         # create_all | alembic
OTEL_ENABLED=0                                # 1 = OpenTelemetry tracing (GenAI conventions for model calls)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # Jaeger/Tempo/Honeycomb, or Langfuse's /api/public/otel
LOG_FORMAT=text                               # text | json (structured, with trace id)

# ---------------------------------------------------------------- optional LLM fallback for unknown PDF layouts (off)
EXTRACTION_LLM_URL=
EXTRACTION_LLM_KEY=                           # (never commit a real key)
EXTRACTION_LLM_MODEL=gpt-4o-mini
# Frontend (only for `npm run dev` against a separate API; the bundled build uses /api)
NEXT_PUBLIC_API_URL=http://localhost:8000
